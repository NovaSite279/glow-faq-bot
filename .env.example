# Copy this file to .env and add your key. .env is in .gitignore, so the key never reaches GitHub.

# Groq, free tier, fast. Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# Or Google Gemini, also free tier (https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash
# LLM_REASONING_EFFORT=low
